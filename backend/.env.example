# Backend only. Use separate development and production projects/credentials.
ENVIRONMENT=development
APP_NAME=CCVO Backend

# Copy the actual transaction pooler URL from the Supabase Connect panel.
# URL-encode reserved characters in credentials. Never ship these URLs to Flutter.
# Runtime uses async SQLAlchemy → asyncpg driver.
DATABASE_URL=postgresql+asyncpg://RUNTIME_USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Use a direct connection (or session pooler when direct IPv6 is unavailable).
# Never use the transaction pooler for migrations.
# Alembic uses sync SQLAlchemy → psycopg driver.
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres?sslmode=require

# Test values are read from the process environment only, never from this .env.
# ENVIRONMENT=test
# ALLOW_TEST_DATABASE_RESET=1
# TEST_DATABASE_URL=postgresql+psycopg://vo_test:local-test-only@127.0.0.1:55439/village_outreach_test

